<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/media_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bord_postmedia"
    android:padding="2dp"
    android:theme="@style/StyleTextMediaCard">

    <TextView
        android:id="@+id/tituloPMedia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:textColor="@color/naranja_enfasis"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/contain_img_profileMedia"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginVertical="2dp"
        app:cardCornerRadius="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tituloPMedia">

        <ImageView
            android:id="@+id/imgProfileAuthorMedia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Imagen de perfil autor"
            android:scaleType="centerCrop"
            tools:srcCompat="@mipmap/ic_launcher" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/cuerpoPMedia"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:minHeight="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/contain_img_profileMedia"
        app:layout_constraintTop_toTopOf="@+id/contain_img_profileMedia" />

    <androidx.cardview.widget.CardView
        android:id="@+id/contain_imgPMedia"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="5dp"
        android:background="@color/transparente"
        android:foregroundGravity="center"
        android:maxHeight="60dp"
        android:padding="5dp"
        app:cardCornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cuerpoPMedia">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/transparente"
            android:orientation="vertical">

            <TextView
                android:id="@+id/linkStream"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:textColor="@color/morado_enfasis"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/nickAuthorMedia"
                app:layout_constraintTop_toTopOf="@+id/contain_img_profileMedia" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_play"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/transparente"
                    android:contentDescription="Reproducir Contenido"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:src="@drawable/ic_play_music" />

                <ImageButton
                    android:id="@+id/btn_copy"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/transparente"
                    android:contentDescription="Copiar Link"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:src="@drawable/ic_btn_copy" />

                <ImageButton
                    android:id="@+id/deletePostMedia"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/transparente"
                    android:contentDescription="Borrar PostMedia"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:src="@drawable/ic_delete"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contain_imgPMedia">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nickAuthorMedia"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="2dp"
                android:layout_weight="1"
                android:ellipsize="start" />

            <TextView
                android:id="@+id/datePostMedia"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="2dp"
                android:layout_weight="1"
                android:ellipsize="end" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_like"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_weight="1"
                android:background="@color/transparente"
                android:contentDescription="Dar Like al Contenido"
                android:foreground="?android:attr/selectableItemBackground"
                android:src="@drawable/ic_like_heart_outlined" />

            <TextView
                android:id="@+id/txtCountLikesPMedia"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>