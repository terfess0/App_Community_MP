<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarSurvey"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aportes &amp; Mods (Sondeo)"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbarSurvey"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card de Advertencia y Riesgos -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                android:backgroundTint="#2D1B1B"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️ Aviso Importante: Mods en SA-MP Android"
                        android:textColor="@color/naranja_enfasis"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="La modificación de archivos en GTA San Andreas Mobile (skins, texturas, timecyc) puede causar cierres inesperados (crashes), problemas con la GPU de tu dispositivo (Adreno, Mali, PowerVR) o scripts maliciosos (stealers) si provienen de fuentes no verificadas.\n\nQueremos conocer tu opinión para decidir si desarrollamos un gestor 100% seguro y probado."
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card de Formulario de Encuesta -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardVotingForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                android:backgroundTint="@color/transparente"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/borde_general"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. ¿Te gustaría poder descargar e instalar mods desde la app?"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp" />

                    <RadioGroup
                        android:id="@+id/radioGroupWantsMods"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp">

                        <RadioButton
                            android:id="@+id/radioYes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sí, me encantaría tener mods verificados"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/radioNo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No, prefiero jugar limpio o sin mods" />
                    </RadioGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. ¿Qué tipo de aportes te interesan más?"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp" />

                    <RadioGroup
                        android:id="@+id/radioGroupModType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp">

                        <RadioButton
                            android:id="@+id/radioSkins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Skins (Facciones, Bandas, Civiles)"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/radioVehicles"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vehículos &amp; Texturas HD" />

                        <RadioButton
                            android:id="@+id/radioHud"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HUDs, Radares, Fuentes &amp; Botones" />

                        <RadioButton
                            android:id="@+id/radioAudio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sonidos, Timecyc &amp; Efectos" />
                    </RadioGroup>

                    <CheckBox
                        android:id="@+id/checkUnderstandRisks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Entiendo los riesgos de incompatibilidad y apoyo la verificación previa de cada mod."
                        android:textSize="12sp"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btnSubmitVote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/naranja_enfasis"
                        android:text="Enviar mi Voto"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progressVote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:indeterminateTint="@color/naranja_enfasis"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card de Resultados / Agradecimiento -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                android:backgroundTint="@color/transparente"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/borde_general"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvStatusVoted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="¡Tu voto ha sido registrado!"
                        android:textColor="@color/naranja_enfasis"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textAlignment="center"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Resultados de la comunidad en tiempo real:"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvStatsYes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="A favor de añadir mods: Calculando..."
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvStatsTotal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total de votos comunitarios: Calculando..."
                        android:textSize="13sp"
                        android:textColor="@color/gris_transparent" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
